<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>バッテリー交換手順 - Google Pixel 7 完全マニュアル</title>
    <style>
        :root {
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.25);
            --danger: #ef4444;
            --danger-glow: rgba(239, 68, 68, 0.2);
            --warning: #f59e0b;
            --warning-glow: rgba(245, 158, 11, 0.15);
            --success: #10b981;
            --success-glow: rgba(16, 185, 129, 0.2);
            --accent: #06b6d4;
            --bg-color: #050b14;
            --card-bg: #0b1329;
            --card-border: #1e294b;
            --text-main: #f1f5f9;
            --text-sub: #64748b;
            --text-highlight: #38bdf8;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Helvetica Neue', Arial, "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(6, 182, 212, 0.05) 0%, transparent 40%);
            color: var(--text-main);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* ─── Scrollbar ─── */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-color); }
        ::-webkit-scrollbar-thumb { background: #1e294b; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--primary); }

        .wrapper {
            max-width: 820px;
            margin: 0 auto;
            padding: 60px 24px 180px; /* HUDに被らないよう下部余白を追加 */
            position: relative;
        }

        /* ─── Header ─── */
        header { text-align: center; margin-bottom: 48px; position: relative; }
        .header-badge {
            display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.2em;
            text-transform: uppercase; color: var(--text-highlight);
            background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25);
            padding: 4px 16px; border-radius: 100px; margin-bottom: 16px;
        }
        header h1 {
            font-size: clamp(24px, 4.5vw, 36px); font-weight: 900; letter-spacing: -0.02em;
            background: linear-gradient(135deg, #a5b4fc 0%, #c084fc 50%, #818cf8 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text; line-height: 1.2; margin-bottom: 12px;
        }
        header p { color: var(--text-sub); font-size: 14px; max-width: 520px; margin: 0 auto; }

        /* ─── Status Control Center ─── */
        .status-card {
            background: rgba(11, 19, 41, 0.7); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--card-border); border-radius: 20px; padding: 24px 30px; margin-bottom: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            position: relative; z-index: 10;
        }
        .status-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px; }
        .status-text { font-weight: 800; font-size: 15px; color: #fff; display: flex; align-items: center; gap: 8px; }
        .status-controls { display: flex; align-items: center; gap: 12px; }
        .status-counter {
            background: linear-gradient(135deg, var(--primary), #4f46e5); color: #fff; padding: 4px 14px;
            border-radius: 100px; font-size: 13px; font-weight: 800; box-shadow: 0 0 15px var(--primary-glow);
        }
        .btn-reset {
            background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); color: #fca5a5;
            padding: 4px 12px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer;
            transition: all 0.2s; display: inline-flex; align-items: center; gap: 4px;
        }
        .btn-reset:hover { background: var(--danger); color: #fff; border-color: transparent; box-shadow: 0 0 15px var(--danger-glow); }

        .progress-bar-bg { width: 100%; height: 10px; background: #10192e; border-radius: 100px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.02); }
        .progress-bar-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 50%, var(--success) 100%); border-radius: 100px; transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 0 10px rgba(16, 185, 129, 0.3); }

        /* ─── Phase Headers ─── */
        .phase-title {
            font-size: 15px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.15em;
            color: var(--text-highlight); margin: 54px 0 24px; padding-left: 14px; border-left: 3px solid var(--primary);
            display: flex; align-items: center; justify-content: space-between;
        }
        .phase-badge { font-size: 11px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2); padding: 2px 8px; border-radius: 4px; color: #a5b4fc; }

        /* ─── Interlocking Step Cards ─── */
        .step-card {
            background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px;
            padding: 30px; margin-bottom: 24px; position: relative; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        }
        .step-card.locked { opacity: 0.35; filter: grayscale(0.2); pointer-events: none; transform: scale(0.98); }
        .step-card.locked::after { content: "🔒 前の工程を完了させてください"; position: absolute; top: 15px; right: 24px; font-size: 11px; font-weight: 700; color: var(--text-sub); background: #111a2e; padding: 2px 8px; border-radius: 4px; border: 1px solid var(--card-border); }
        .step-card.active-focus { border-color: var(--primary); box-shadow: 0 0 30px rgba(99, 102, 241, 0.15), inset 0 0 12px rgba(99, 102, 241, 0.05); transform: translateY(-2px); }
        .step-card.active-focus::before { content: "👉 CURRENT STEP"; position: absolute; top: -10px; left: 24px; font-size: 9px; font-weight: 900; letter-spacing: 0.1em; color: #000; background: #fbbf24; padding: 2px 8px; border-radius: 4px; box-shadow: 0 4px 10px rgba(251, 191, 36, 0.3); }
        .step-card.completed { border-color: rgba(16, 185, 129, 0.3); background: rgba(11, 30, 31, 0.4); opacity: 0.65; }

        .step-card.danger-level { border-left: 4px solid var(--danger); }
        .step-card.warning-level { border-left: 4px solid var(--warning); }
        .step-card.normal-level { border-left: 4px solid var(--primary); }
        .step-card.success-level { border-left: 4px solid var(--success); }

        .step-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; gap: 16px; }
        .step-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
        .step-number { font-size: 12px; font-weight: 900; color: #fff; background: var(--primary); padding: 3px 10px; border-radius: 6px; letter-spacing: 0.05em; }
        .step-time { font-size: 11px; font-weight: 700; color: var(--text-highlight); background: rgba(56, 189, 248, 0.08); padding: 3px 8px; border-radius: 6px; }
        .tool-badge { font-size: 11px; font-weight: 700; color: #cbd5e1; background: #1e293b; padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.05); }
        .badge-danger-text { color: var(--danger); background: var(--danger-glow); font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(239, 68, 68, 0.15); }
        .badge-warning-text { color: var(--warning); background: var(--warning-glow); font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(245, 158, 11, 0.15); }

        .checkbox-wrapper { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 14px; font-weight: 800; color: var(--text-sub); user-select: none; white-space: nowrap; background: #141f3d; border: 1px solid var(--card-border); padding: 6px 16px; border-radius: 10px; transition: all 0.2s; }
        .checkbox-wrapper:hover { color: #fff; border-color: var(--primary); background: var(--primary-glow); }
        .checkbox-wrapper input { width: 18px; height: 18px; cursor: pointer; accent-color: var(--success); }
        .step-card.completed .checkbox-wrapper { color: var(--success); border-color: rgba(16, 185, 129, 0.3); background: rgba(16, 185, 129, 0.08); }

        .step-text { font-size: 15px; color: #cbd5e1; margin-bottom: 20px; line-height: 1.8; }
        .step-image-container { width: 100%; max-height: 380px; background: #060b13; border-radius: 14px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.03); margin-top: 15px; position: relative; }
        .step-image-container img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
        .step-card:hover .step-image-container img { transform: scale(1.02); }

        /* ─── Footer Action Area ─── */
        .action-area { text-align: center; margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--card-border); }
        .btn-next { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; max-width: 440px; padding: 18px 32px; background: #1e2e4a; color: #4a6080; border: 1px solid #1e3050; border-radius: 16px; font-size: 16px; font-weight: 800; cursor: not-allowed; text-decoration: none; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .btn-next.ready { background: linear-gradient(135deg, var(--success), #059669); color: #fff; border-color: transparent; cursor: pointer; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3); }
        .btn-next.ready:hover { transform: translateY(-2px); box-shadow: 0 15px 35px rgba(16, 185, 129, 0.4); }
        .btn-back { display: inline-block; margin-top: 24px; color: var(--text-sub); text-decoration: none; font-size: 13px; font-weight: 700; transition: color 0.2s; }
        .btn-back:hover { color: #fff; }

        /* ─── 【NEW】AI Copilot (音声操作) HUD パネル ─── */
        .hud-copilot {
            position: fixed;
            bottom: 24px;
            left: 24px;
            width: 260px;
            background: rgba(11, 19, 41, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 16px;
            padding: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            z-index: 9998;
            font-family: monospace;
            transition: all 0.3s ease;
        }
        .hud-copilot-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 8px;
        }
        .hud-copilot-title { font-size: 12px; font-weight: 900; color: var(--accent); letter-spacing: 0.1em; display: flex; align-items: center; gap: 6px; }
        .pulse-dot { width: 8px; height: 8px; background: #64748b; border-radius: 50%; box-shadow: 0 0 8px transparent; }
        .pulse-dot.listening { background: var(--danger); box-shadow: 0 0 12px var(--danger); animation: blink 1.5s infinite; }
        .hud-status-text { font-size: 11px; color: #94a3b8; }
        
        .hud-copilot-content { font-size: 13px; color: #fff; margin-bottom: 12px; min-height: 40px; display: flex; align-items: center; }
        .cmd-hint { color: #64748b; font-size: 11px; }
        .cmd-hint span { color: #a5b4fc; }

        .btn-mic {
            width: 100%; padding: 8px; background: rgba(56, 189, 248, 0.1);
            border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 8px;
            color: var(--accent); font-weight: bold; cursor: pointer; font-size: 12px; transition: all 0.2s;
        }
        .btn-mic:hover { background: rgba(56, 189, 248, 0.2); }
        .btn-mic.active { background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.4); color: var(--danger); }

        /* ─── 【NEW】カメラモニター (ピクチャー・イン・ピクチャー風) ─── */
        .hud-camera {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 220px;
            height: 165px;
            background: #000;
            border: 2px solid rgba(16, 185, 129, 0.4);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            z-index: 9998;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #475569;
            font-size: 12px;
        }
        .hud-camera video { width: 100%; height: 100%; object-fit: cover; }
        .camera-badge {
            position: absolute; top: 6px; left: 8px; background: rgba(0,0,0,0.6);
            color: var(--success); font-size: 9px; font-weight: bold; padding: 2px 6px;
            border-radius: 4px; font-family: monospace; border: 1px solid rgba(16, 185, 129, 0.3);
        }
        .btn-cam-toggle {
            position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.7);
            border: 1px solid #475569; color: #fff; font-size: 10px; padding: 4px 8px;
            border-radius: 4px; cursor: pointer; transition: all 0.2s;
        }
        .btn-cam-toggle:hover { background: rgba(255,255,255,0.2); }

        /* ─── 既存：緊急ボタン（位置をカメラの上に調整） ─── */
        .emergency-btn {
            position: fixed;
            bottom: 210px; /* HUDカメラの上に配置 */
            right: 24px;
            width: 60px; height: 60px;
            background-color: #ef4444; color: white; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center;
            font-weight: 900; font-size: 10px; box-shadow: 0 10px 25px rgba(239, 68, 68, 0.4); cursor: grab; z-index: 9999; user-select: none; touch-action: none;
            border: 2px solid #fca5a5; transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.2s;
        }
        .emergency-btn:active { cursor: grabbing; }
        .emergency-btn.primed { transform: scale(1.3); background-color: #dc2626; box-shadow: 0 0 35px rgba(220, 38, 38, 0.8); border-color: #fef08a; cursor: pointer; }

        @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

        /* ─── 紙吹雪コンテナ ─── */
        .confetti-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 99999; }

        @media (max-width: 768px) {
            .hud-copilot { bottom: auto; top: 16px; left: 16px; width: calc(100% - 32px); z-index: 99999; }
            .hud-camera { width: 140px; height: 105px; bottom: 16px; right: 16px; }
            .emergency-btn { bottom: 140px; }
            .wrapper { padding-top: 160px; } /* スマホ時は上部にCopilotが来るため余白追加 */
        }
    </style>
</head>
<body>

<div id="progress-track"><div id="progress-fill"></div></div>

<div class="wrapper">
    <header>
        <div class="header-badge">Pixel 7 Maintenance Manual</div>
        <h1 id="procedure-title">Google Pixel 7 交換手順</h1>
        <p>提供された17の精密工程マニュアル。チェックを入れながら安全に進めてください。</p>
    </header>

    <div class="status-card">
        <div class="status-header">
            <span class="status-text" id="status-message">⏳ 焦らず最初のステップから慎重に始めましょう。</span>
            <div class="status-controls">
                <span class="status-counter" id="status-counter">0 / 17 完了</span>
                <button class="btn-reset" id="btn-reset" title="進捗チェックをすべて外して最初からやり直します。">🔄 最初から行う</button>
            </div>
        </div>
        <div class="progress-bar-bg"><div class="progress-bar-fill" id="progress-bar-fill"></div></div>
    </div>

    <div id="steps-container"></div>

    <div class="action-area">
        <div class="action-hint" id="action-hint" style="font-size:14px; color:var(--text-sub); margin-bottom:16px; font-weight:700;">
            ⚠️ すべての工程を完了するまで次のページへは進めません
        </div>
        <a href="#" id="next-page-btn" class="btn-next">すべての作業を完了して次へ →</a>
        <a href="front.html" class="btn-back">トップページに戻る</a>
    </div>
</div>

<!-- 【NEW】AI Copilot パネル -->
<div class="hud-copilot">
    <div class="hud-copilot-header">
        <div class="hud-copilot-title">
            <div class="pulse-dot" id="voice-pulse"></div>
            AI COPILOT
        </div>
        <div class="hud-status-text" id="voice-status">マイクはオフです</div>
    </div>
    <div class="hud-copilot-content" id="voice-result">
        音声操作を使用できます。
    </div>
    <div class="cmd-hint">
        有効なコマンド: <span>「完了」「次」「緊急」</span>
    </div>
    <button class="btn-mic" id="btn-toggle-mic" style="margin-top: 10px;">🎙️ 音声コマンドを開始</button>
</div>

<!-- 【NEW】カメラモニター HUD -->
<div class="hud-camera" id="camera-hud">
    <div class="camera-badge">SAFETY CAM</div>
    <video id="webcam-video" autoplay playsinline muted></video>
    <div id="camera-placeholder">カメラ未起動</div>
    <button class="btn-cam-toggle" id="btn-toggle-cam">ON / OFF</button>
</div>

<!-- 緊急ボタン -->
<div id="emergency-btn" class="emergency-btn" title="ドラッグで移動できます / 異常発熱などの非常時はこちら">
    <span class="icon" id="emg-icon">🚨</span>
    <span class="text" id="emg-text">緊急</span>
</div>

<canvas id="confetti-canvas" class="confetti-canvas"></canvas>

<script>
    // ── 17の精密プロセスデータベース ──
    const procedureDatabase = {
        "googlepixel7": {
            name: "Google Pixel 7",
            steps: [
                { phase: "Phase 1: 事前準備", label: "準備", level: "normal", tools: ["放電"], time: "⏳ 10分", text: "バッテリーを 20%以下まで放電します。満充電状態での作業は、万が一の破損時の発火リスクが非常に高いため必ず実施してください。", img: "images/p7_step1.jpg" },
                { phase: "Phase 2: スクリーンの開封と分離", label: "分解", level: "danger", tools: ["ヒートガン", "吸盤", "ピック"], time: "⏳ 5分", text: "スクリーン周辺を加熱して内部の強力な接着テープを緩め、吸盤とピックを隙間に差し込んで丁寧に取り外します。", img: "images/p7_step2.jpg" },
                { phase: "Phase 2: スクリーンの開封と分離", label: "分解", level: "warning", tools: ["ピンセット", "スパッジャー"], time: "⏳ 2分", text: "スクリーンと本体基板を接続しているデリケートな液晶ディスプレイケーブルを傷つけないよう慎重に外します。", img: "images/p7_step3.jpg" },
                { phase: "Phase 3: 内部ミッドフレームの分解", label: "分解", level: "normal", tools: ["ピンセット"], time: "⏳ 1分", text: "基板上の重要なICチップや配線を保護している黒いシリコンパッドを取り外します。", img: "images/p7_step4.jpg" },
                { phase: "Phase 3: 内部ミッドフレーム of 分解", label: "分解", level: "warning", tools: ["ヒートガン", "ピック"], time: "⏳ 3分", text: "グラファイト放熱シート（黒い膜のようなもの）をはがします。破かないようにヒートガンで少し温めながら慎重に行ってください。", img: "images/p7_step5.jpg" },
                { phase: "Phase 3: 内部ミッドフレームの分解", label: "分解", level: "normal", tools: ["T2トルクスドライバー"], time: "⏳ 2分", text: "本体下部分にあるラウドスピーカー（スピーカーモジュール）を取り外します。", img: "images/p7_step6.jpg" },
                { phase: "Phase 3: 内部ミッドフレームの分解", label: "分解", level: "normal", tools: ["T2/T3ドライバー"], time: "⏳ 4分", text: "バッテリーの周りを強固にガードしている銀色の金属製ミッドフレームのネジをすべて外し、フレーム本体を静かに取り出します。", img: "images/p7_step7.jpg" },
                { phase: "Phase 4: 古いバッテリーの摘出と交換", label: "交換", level: "danger", tools: ["スパッジャー", "ピンセット"], time: "⏳ 2分", text: "ショートを未然に防ぐため、本体基板とつながっているバッテリーケーブル（電源コネクタ）を、スパッジャーを用いて慎重に持ち上げて外します。", img: "images/p7_step8.jpg" },
                { phase: "Phase 4: 古いバッテリーの摘出と交換", label: "交換", level: "normal", tools: ["クリーニングヘラ"], time: "⏳ 2分", text: "基板に塗られている古い放熱グリスをきれいに剥がします（※バッテリー交換後に新しいグリスを塗り直します）。", img: "images/p7_step9.jpg" },
                { phase: "Phase 4: 古いバッテリーの摘出と交換", label: "交換", level: "warning", tools: ["ヒートガン"], time: "⏳ 3分", text: "バッテリーを無理やり剥がすと発火・変形するため、スマホの背面側から適度に温め、バッテリーの裏側にある粘着剤を緩めます。", img: "images/p7_step10.jpg" },
                { phase: "Phase 4: 古いバッテリーの摘出と交換", label: "交換", level: "danger", tools: ["無水エタノール"], time: "⏳ 5分", text: "バッテリーのプルテープを引いて接着剤をはがします。硬い場合は無水エタノール（アルコール溶液）を隙間に数滴垂らし、粘着を溶かしながらスパッジャー等で浮かせます。", img: "images/p7_step11.jpg" },
                { phase: "Phase 4: 古いバッテリーの摘出と交換", label: "交換", level: "normal", tools: ["手袋着用"], time: "⏳ 1分", text: "接着が完全に剥がれたら、古いバッテリーを傷つけないようまっすぐ引き上げて本体から安全に摘出します。", img: "images/p7_step12.jpg" },
                { phase: "Phase 4: 古いバッテリーの摘出と交換", label: "交換", level: "success", tools: ["新しいグリス"], time: "⏳ 3分", text: "新しい交換用バッテリーを枠に沿ってはめ込み、あらかじめ綺麗にしたエリアに新しい放熱グリスを塗り直します。", img: "images/p7_step13.jpg" },
                { phase: "Phase 5: 本体の復元と圧着", label: "組立", level: "normal", tools: ["各種ドライバー"], time: "⏳ 5分", text: "ミッドフレーム、スピーカー、保護シート類を取り外し時と完全に逆の手順で丁寧に組み立て、ネジをしっかりと締めます。", img: "images/p7_step14.jpg" },
                { phase: "Phase 5: 本体の復元と圧着", label: "組立", level: "warning", tools: ["スクリーン用テープ"], time: "⏳ 4分", text: "スクリーンを閉じる前に、本体フレームのフチに残った古い接着剤のカスを完全に取り除き、新しい替えのスクリーン用防水両面テープ枠をズレなく貼ります。", img: "images/p7_step15.jpg" },
                { phase: "Phase 5: 本体の復元と圧着", label: "組立", level: "warning", tools: ["手"], time: "⏳ 2分", text: "スクリーンの液晶ディスプレイケーブルを基板の端子にしっかりと接続し、フレームの四隅に歪みがないか確認しながら、ディスプレイを滑らかに押し込みます。", img: "images/p7_step16.jpg" },
                { phase: "Phase 5: 本体の復元と圧着", label: "組立", level: "success", tools: ["クランプ/重り"], time: "⏳ 1時間〜", text: "接着剤を完全に定着させ、将来の画面浮きを防ぐため、スマホの上に均等に負荷がかかる重りを置くか、クランプでしっかりと挟んでしばらくの間放置して圧着を完了させます。", img: "images/p7_step17.jpg" }
            ]
        }
    };

    // グローバル変数で現在の最新ステップのインデックスを保持
    let currentActiveIndex = 0;
    let totalStepsGlobal = 0;

    window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const deviceKey = urlParams.get('device') || 'googlepixel7';
        const storageKey = `saved_step_${deviceKey}`;

        if (deviceKey && procedureDatabase[deviceKey]) {
            const data = procedureDatabase[deviceKey];
            document.getElementById('procedure-title').innerText = data.name + " バッテリー交換手順";

            const container = document.getElementById('steps-container');
            const totalSteps = data.steps.length;
            totalStepsGlobal = totalSteps;
            
            let savedProgress = null;
            try {
                const stored = localStorage.getItem(storageKey);
                if (stored) savedProgress = JSON.parse(stored);
            } catch(e) { console.error("Progress parsing failed", e); }
            
            if (!Array.isArray(savedProgress) || savedProgress.length !== totalSteps) {
                savedProgress = new Array(totalSteps).fill(false);
                localStorage.setItem(storageKey, JSON.stringify(savedProgress));
            }

            let currentPhase = "";

            data.steps.forEach((step, index) => {
                const stepNum = index + 1;

                if (currentPhase !== step.phase) {
                    currentPhase = step.phase;
                    const phaseHeader = document.createElement('div');
                    phaseHeader.className = 'phase-title';
                    phaseHeader.innerHTML = `<span>${currentPhase}</span><span class="phase-badge">${step.label}</span>`;
                    container.appendChild(phaseHeader);
                }

                const card = document.createElement('div');
                card.className = `step-card ${step.level}-level`;
                card.id = `step-card-${index}`;

                const badgesHTML = step.tools.map(tool => `<span class="tool-badge">${tool}</span>`).join(' ');
                let alertBadge = '';
                if (step.level === 'danger') alertBadge = '<span class="badge-danger-text">⚠️ 発火危険度高</span>';
                if (step.level === 'warning') alertBadge = '<span class="badge-warning-text">⚠️ 破損注意</span>';

                card.innerHTML = `
                    <div class="step-header">
                        <div class="step-meta"><span class="step-number">STEP ${stepNum}</span><span class="step-time">${step.time}</span>${badgesHTML}${alertBadge}</div>
                        <label class="checkbox-wrapper"><input type="checkbox" id="check-${index}"><span>完了</span></label>
                    </div>
                    <div class="step-text">${step.text}</div>
                    <div class="step-image-container"><img src="${step.img}" alt="Step ${stepNum}の写真" onerror="this.style.display='none';"></div>
                `;

                container.appendChild(card);

                const checkbox = card.querySelector(`#check-${index}`);
                checkbox.checked = savedProgress[index];
                if (savedProgress[index]) card.classList.add('completed');

                checkbox.addEventListener('change', (e) => {
                    handleCheckChange(index, e.target.checked);
                });
            });

            // チェック状態変更処理を関数化（音声コマンドからも呼べるように）
            window.handleCheckChange = function(index, isChecked) {
                const card = document.getElementById(`step-card-${index}`);
                const checkbox = document.getElementById(`check-${index}`);
                if(!card || !checkbox) return;
                
                checkbox.checked = isChecked;
                if (isChecked) {
                    card.classList.add('completed');
                    savedProgress[index] = true;
                } else {
                    card.classList.remove('completed');
                    savedProgress[index] = false;
                }
                localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                updateStatus(savedProgress, totalSteps);
                updateInterlockingFocus(savedProgress, totalSteps, true); // スクロールON
            };

            document.getElementById('btn-reset').addEventListener('click', () => {
                if(confirm("進捗をすべてリセットして最初からやり直しますか？")) {
                    savedProgress = new Array(totalSteps).fill(false);
                    localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                    data.steps.forEach((_, index) => {
                        const card = document.getElementById(`step-card-${index}`);
                        const checkbox = document.getElementById(`check-${index}`);
                        if(card && checkbox) { card.classList.remove('completed'); checkbox.checked = false; }
                    });
                    updateStatus(savedProgress, totalSteps);
                    updateInterlockingFocus(savedProgress, totalSteps, false);
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });

            updateStatus(savedProgress, totalSteps);
            updateInterlockingFocus(savedProgress, totalSteps, false);
            document.getElementById('next-page-btn').href = `troubleshooting.html?device=${deviceKey}`;

        } else {
            document.getElementById('procedure-title').innerText = "エラー";
            document.getElementById('steps-container').innerHTML = "<p>データが見つかりません。</p>";
        }
    });

    function updateStatus(progressArray, total) {
        const doneCount = progressArray.filter(status => status === true).length;
        document.getElementById('status-counter').innerText = `${doneCount} / ${total} 完了`;
        const percent = Math.round((doneCount / total) * 100);
        document.getElementById('progress-bar-fill').style.width = percent + "%";

        const msgElement = document.getElementById('status-message');
        const nextBtn = document.getElementById('next-page-btn');
        const hintElement = document.getElementById('action-hint');

        if (doneCount === 0) msgElement.innerText = "⏳ 焦らず最初のステップから慎重に始めましょう。";
        else if (doneCount === total) { msgElement.innerText = "🎉 17工程すべて完了！素晴らしい作業精度です！"; triggerConfetti(); }
        else msgElement.innerText = `🛠️ 現在順調に進んでいます（全体の ${percent}% 完了）`;

        if (doneCount === total) {
            nextBtn.classList.add('ready');
            hintElement.style.color = 'var(--success)'; hintElement.innerText = '✅ 安全に完了しました！次のトラブルシューティングページへ進めます。';
        } else {
            nextBtn.classList.remove('ready');
            hintElement.style.color = 'var(--text-sub)'; hintElement.innerText = '⚠️ すべての工程を完了するまで次のページへは進めません';
        }
    }

    function updateInterlockingFocus(progressArray, total, shouldScroll = false) {
        let firstUnfinishedIndex = progressArray.findIndex(status => status === false);
        if (firstUnfinishedIndex === -1) firstUnfinishedIndex = total;
        
        // グローバル変数に現在のステップを保存（音声コマンドで使うため）
        currentActiveIndex = firstUnfinishedIndex;

        let targetCard = null;
        for (let i = 0; i < total; i++) {
            const card = document.getElementById(`step-card-${i}`);
            if (!card) continue;
            card.classList.remove('active-focus', 'locked');

            if (i < firstUnfinishedIndex) {
                card.classList.add('completed');
            } else if (i === firstUnfinishedIndex) {
                card.classList.add('active-focus');
                card.classList.remove('completed');
                targetCard = card;
            } else {
                card.classList.add('locked');
            }
        }

        if (shouldScroll) {
            if (targetCard) {
                setTimeout(() => { targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 250);
            } else if (firstUnfinishedIndex === total) {
                setTimeout(() => { document.querySelector('.action-area').scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 300);
            }
        }
    }

    /* ─── 🎤 【NEW】Web Speech API (ハンズフリー音声操作) ─── */
    const btnMic = document.getElementById('btn-toggle-mic');
    const voiceStatus = document.getElementById('voice-status');
    const voiceResult = document.getElementById('voice-result');
    const pulseDot = document.getElementById('voice-pulse');
    
    let recognition = null;
    let isListening = false;

    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = 'ja-JP';
        recognition.continuous = true; // 連続で聞き取る
        recognition.interimResults = false;

        recognition.onstart = () => {
            isListening = true;
            pulseDot.classList.add('listening');
            btnMic.classList.add('active');
            btnMic.innerText = '🛑 マイクを停止';
            voiceStatus.innerText = '音声コマンド待機中...';
            voiceStatus.style.color = 'var(--danger)';
            voiceResult.innerText = '作業しながら「完了」と発話してください';
        };

        recognition.onresult = (event) => {
            const last = event.results.length - 1;
            const transcript = event.results[last][0].transcript.trim().toLowerCase();
            console.log("認識結果:", transcript);

            voiceResult.innerHTML = `認識: <strong style="color:var(--accent)">「${transcript}」</strong>`;

            // 【コマンド判定】
            if (transcript.includes('完了') || transcript.includes('次') || transcript.includes('チェック') || transcript.includes('できた')) {
                // 現在のアクティブなステップにチェックを入れる
                if (currentActiveIndex < totalStepsGlobal) {
                    voiceResult.innerHTML += `<br><span style="color:var(--success)">✅ STEP ${currentActiveIndex + 1} を完了しました</span>`;
                    window.handleCheckChange(currentActiveIndex, true);
                } else {
                    voiceResult.innerHTML += `<br><span>すべてのステップが完了しています。</span>`;
                }
            } 
            else if (transcript.includes('緊急') || transcript.includes('助けて') || transcript.includes('ファイヤー') || transcript.includes('発火')) {
                voiceResult.innerHTML += `<br><span style="color:var(--danger)">🚨 緊急モード起動！消火ページへ移行します</span>`;
                setTimeout(() => { window.location.href = 'emergency.html'; }, 1000);
            }
        };

        recognition.onerror = (event) => {
            console.error('Speech recognition error', event.error);
            if(event.error !== 'no-speech') {
                voiceStatus.innerText = 'エラー発生';
                stopListening();
            }
        };

        recognition.onend = () => {
            // continuousが途切れた場合は自動再起動（手動で停止した場合を除く）
            if (isListening) {
                recognition.start();
            }
        };

    } else {
        btnMic.disabled = true;
        btnMic.innerText = 'お使いのブラウザは音声操作非対応です';
        voiceStatus.innerText = '非対応ブラウザ';
    }

    function stopListening() {
        isListening = false;
        if(recognition) recognition.stop();
        pulseDot.classList.remove('listening');
        btnMic.classList.remove('active');
        btnMic.innerText = '🎙️ 音声コマンドを開始';
        voiceStatus.innerText = 'マイクはオフです';
        voiceStatus.style.color = '#94a3b8';
    }

    btnMic.addEventListener('click', () => {
        if (!recognition) return;
        if (isListening) {
            stopListening();
        } else {
            // セキュリティ上、HTTPSかlocalhostでないとマイクは許可されない
            try {
                recognition.start();
            } catch(e) {
                console.error(e);
            }
        }
    });


    /* ─── 📷 【NEW】MediaDevices API (カメラモニター) ─── */
    const videoElement = document.getElementById('webcam-video');
    const btnCamToggle = document.getElementById('btn-toggle-cam');
    const placeholder = document.getElementById('camera-placeholder');
    let webcamStream = null;

    btnCamToggle.addEventListener('click', async () => {
        if (webcamStream) {
            // カメラOFF
            webcamStream.getTracks().forEach(track => track.stop());
            videoElement.srcObject = null;
            webcamStream = null;
            placeholder.style.display = 'block';
        } else {
            // カメラON
            try {
                // セキュリティ上、HTTPSかlocalhostでないとカメラは許可されない
                webcamStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
                videoElement.srcObject = webcamStream;
                placeholder.style.display = 'none';
            } catch (err) {
                console.error("Camera access denied or error:", err);
                alert("カメラの起動に失敗しました。ローカルサーバー（http://127.0.0.1:5500）で開いているか、ブラウザの権限設定を確認してください。");
            }
        }
    });

    // ── 紙吹雪・緊急ボタン等の既存スクリプト ──
    function triggerConfetti() {
        const canvas = document.getElementById('confetti-canvas');
        const ctx = canvas.getContext('2d');
        let animationFrameId;
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
        const colors = ['#10b981', '#6366f1', '#06b6d4', '#f59e0b', '#f43f5e', '#fbbf24'];
        const particles = [];
        for (let i = 0; i < 120; i++) {
            particles.push({
                x: Math.random() * canvas.width, y: Math.random() * canvas.height - canvas.height,
                size: Math.random() * 8 + 5, color: colors[Math.floor(Math.random() * colors.length)],
                speed: Math.random() * 3 + 2, rotation: Math.random() * 360, rotationSpeed: Math.random() * 4 - 2
            });
        }
        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            let active = false;
            particles.forEach(p => {
                if (p.y < canvas.height) {
                    active = true; p.y += p.speed; p.rotation += p.rotationSpeed;
                    ctx.save(); ctx.translate(p.x, p.y); ctx.rotate((p.rotation * Math.PI) / 180);
                    ctx.fillStyle = p.color; ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size); ctx.restore();
                }
            });
            if (active) animationFrameId = requestAnimationFrame(draw);
            else { ctx.clearRect(0, 0, canvas.width, canvas.height); cancelAnimationFrame(animationFrameId); }
        }
        draw();
        window.addEventListener('resize', () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; });
    }

    // 緊急ボタンのドラッグ
    const emergencyBtn = document.getElementById('emergency-btn');
    const emgIcon = document.getElementById('emg-icon');
    const emgText = document.getElementById('emg-text');
    let isDragging = false, hasMoved = false, startX, startY, initialLeft, initialTop, isPositionInitialized = false;

    function getEventClient(e) { return (e.touches && e.touches.length > 0) ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : { x: e.clientX, y: e.clientY }; }
    function dragStart(e) {
        if (e.type === "mousedown" && e.button !== 0) return;
        const pos = getEventClient(e);
        if (!isPositionInitialized) {
            const rect = emergencyBtn.getBoundingClientRect();
            emergencyBtn.style.left = rect.left + 'px'; emergencyBtn.style.top = rect.top + 'px';
            emergencyBtn.style.right = 'auto'; emergencyBtn.style.bottom = 'auto'; isPositionInitialized = true;
        }
        initialLeft = emergencyBtn.offsetLeft; initialTop = emergencyBtn.offsetTop;
        startX = pos.x; startY = pos.y; isDragging = true; hasMoved = false;
    }
    function drag(e) {
        if (!isDragging) return;
        const pos = getEventClient(e); const dx = pos.x - startX, dy = pos.y - startY;
        if (Math.abs(dx) > 6 || Math.abs(dy) > 6) hasMoved = true;
        if (hasMoved) {
            e.preventDefault();
            let newLeft = initialLeft + dx, newTop = initialTop + dy;
            const maxX = window.innerWidth - emergencyBtn.offsetWidth, maxY = window.innerHeight - emergencyBtn.offsetHeight;
            emergencyBtn.style.left = Math.max(0, Math.min(newLeft, maxX)) + 'px';
            emergencyBtn.style.top = Math.max(0, Math.min(newTop, maxY)) + 'px';
        }
    }
    function dragEnd(e) {
        if (!isDragging) return;
        isDragging = false;
        if (!hasMoved) handleEmergencyClick();
    }
    emergencyBtn.addEventListener('mousedown', dragStart); document.addEventListener('mousemove', drag); document.addEventListener('mouseup', dragEnd);
    emergencyBtn.addEventListener('touchstart', dragStart, {passive: false}); document.addEventListener('touchmove', drag, {passive: false}); document.addEventListener('touchend', dragEnd);

    let isPrimed = false, primeTimeout;
    function handleEmergencyClick() {
        if (!isPrimed) {
            isPrimed = true; emergencyBtn.classList.add('primed'); emgIcon.innerText = '🔥'; emgText.innerHTML = '消火<br>手順へ';
            clearTimeout(primeTimeout); primeTimeout = setTimeout(resetEmergencyBtn, 6000);
        } else {
            window.location.href = 'emergency.html';
        }
    }
    function resetEmergencyBtn() { isPrimed = false; emergencyBtn.classList.remove('primed'); emgIcon.innerText = '🚨'; emgText.innerText = '緊急'; }
</script>

